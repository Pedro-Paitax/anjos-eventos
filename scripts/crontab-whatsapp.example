# Exemplo de crontab (usuário opc, Oracle). NÃO contém segredos: o token fica em
# ~/.anjos-cron.env (chmod 600) com uma linha:  CRON_TOKEN=...
# Fuso do negócio: America/Sao_Paulo.
CRON_TZ=America/Sao_Paulo

# A cada 15 min — Ordem de Ação (dispara quando faltam 2h10 ou menos e o evento ainda não começou;
# o disparo duplicado é impedido por ordens_disparadas_em, então rodar 2x é seguro)
*/15 * * * * . ~/.anjos-cron.env && curl -fsS -X POST -H "Authorization: Bearer $CRON_TOKEN" http://127.0.0.1:3001/api/cron/ordem-acao >> ~/anjos-cron.log 2>&1

# 09:00 — Lembrete de 7 dias (pendências)
0 9 * * * . ~/.anjos-cron.env && curl -fsS -X POST -H "Authorization: Bearer $CRON_TOKEN" http://127.0.0.1:3001/api/cron/lembrete-7-dias >> ~/anjos-cron.log 2>&1

# Prospecção — envio automático de WhatsApp (decisão 2026-10-29, ver docs/PROSPECCAO.md).
# NÃO instale antes de: migração 0010 aplicada, deploy feito, teste só no número do Pedro e
# envio automático ligado na tela. Cada chamada envia NO MÁXIMO UM lead (teto 10/dia no código);
# fora da janela, desligado ou sem WhatsApp conectado a chamada não faz nada.
# 1-59/20 = minutos 1, 21, 41 (fora do :00 para não competir com os outros jobs).
#1-59/20 9-17 * * 1-5 . ~/.anjos-cron.env && curl -fsS -m 150 -X POST -H "Authorization: Bearer $CRON_TOKEN" http://127.0.0.1:3001/api/cron/prospeccao-envio >> ~/anjos-cron.log 2>&1
